<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="view_account_payment_form_print_voucher" model="ir.ui.view">
            <field name="name">account.payment.form.print.voucher</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
            	<field name="state" position="before">
            		<button name="print_vourcher" 
                        string="Cash Receipt &amp; Payment Voucher" 
                        type="object" class="oe_highlight" 
                        invisible="not is_print"
                        />
            	</field>
            	<field name="ref" position="after">
            		<field name="number_sequence" invisible="1"/>
            		<field name="payer" 
                        invisible="not is_print"
                        />
            		<field name="is_print" invisible="1"/>
            	</field>
                <field name="journal_id" position="after">
                    <field name="including" 
                        invisible="not is_print"
                        />
                </field>
            </field>
        </record>
        <record id="view_account_payment_tree_inherit" model="ir.ui.view">
            <field name="name">view.account.payment.tree</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="number_sequence"/>
                </xpath>
            </field>
        </record>
	</data>
</odoo>
