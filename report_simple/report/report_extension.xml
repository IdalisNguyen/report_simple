<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="paperformat_a4_portrait" model="report.paperformat">
	    <field name="name">Report A4 portrait</field>
	    <field name="default" eval="False" />
	    <field name="format">A4</field>
	    <field name="orientation">Portrait</field>
	    <field name="margin_top">5</field>
	    <field name="margin_bottom">5</field>
	    <field name="margin_left">10</field>
	    <field name="margin_right">10</field>
	    <field name="header_line" eval="False" />
	    <field name="header_spacing">35</field>
	    <field name="dpi">90</field>
	</record>

	<record id="paperformat_a5_landscape" model="report.paperformat">
	    <field name="name">Report A5 landscape</field>
	    <field name="default" eval="False" />
	    <field name="format">A5</field>
	    <field name="orientation">Landscape</field>
	    <field name="margin_top">5</field>
	    <field name="margin_bottom">10</field>
	    <field name="margin_left">10</field>
	    <field name="margin_right">10</field>
	    <field name="header_line" eval="False" />
	    <field name="header_spacing">35</field>
	    <field name="dpi">90</field>
	</record>

	<record id="account_rp_invoice_payment_invoice" model="ir.actions.report">
		<field name="name">Print cash receipt &amp; payment voucher</field>
		<field name="model">account.bank.statement.line</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">biz_voucher_report_simple.rp_invoice_payment</field>
		<field name="report_file">biz_voucher_report_simple.rp_invoice_payment</field>
		<field name="print_report_name">'Cash receipt &amp; payment voucher'</field>
		<field name="binding_type">report</field>
		<field name="binding_model_id" ref="account.model_account_move"/>
		<field name="paperformat_id" ref="biz_voucher_report_simple.paperformat_a5_landscape"/>
	</record>
</odoo>